# ==============================================================================
# MealAI Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# PUBLIC / Client Environment Variables (Exposed to browser via Vite):
# Retrieve your publishable key from https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# SERVER-ONLY Environment Variables (NEVER exposed to browser / client code):
# Retrieve your secret key from https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_...

# Google Gemini API Key (Optional: for generative AI features. If omitted, heuristic fallbacks are used)
GEMINI_API_KEY=

# Server Port and Base URL
APP_URL=http://localhost:3000
PORT=3000
