# ==============================================================================
# MealAI Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# Clerk Authentication (Required)
# Retrieve your keys from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Routing URLs (Optional, defaults configured in app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini API Key (Optional: for live generative AI features. If omitted, fallback heuristics are used)
GEMINI_API_KEY=

# Application Base URL
APP_URL=http://localhost:3000

# Server Port (Default: 3000)
PORT=3000
